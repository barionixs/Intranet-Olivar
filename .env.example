DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dominio real del sitio en producción — usado para armar el link del QR
# de verificación en los PDF institucionales.
DJANGO_SITE_URL=http://localhost:8000

DB_NAME=intranet_olivar
DB_USER=intranet_olivar
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Solo para Vercel: si existe DATABASE_URL (la crea automáticamente la
# integración de Postgres/Neon en el dashboard de Vercel), se usa esa
# conexión en vez de los DB_* de arriba. Dejar vacío en desarrollo local.
# DATABASE_URL=

# Opcional: fuerza la contraseña del super admin al correr
# "aprovisionar_usuarios" en vez de generar una aleatoria.
# SUPERADMIN_PASSWORD=

# Solo para desplegar en Vercel: token del Blob store (Storage > Create
# Database > Blob en el dashboard de Vercel). Si está definido, los
# archivos subidos (comprobantes de firma, PDF de permisos, licencias
# médicas, liquidaciones) se guardan ahí en vez de en disco local, porque
# en Vercel el filesystem es de solo lectura y no persiste. Dejar vacío
# en desarrollo local.
# BLOB_READ_WRITE_TOKEN=

# Solo para Vercel: conversión docx -> PDF del formato institucional de
# permisos, vía Gotenberg (LibreOffice en Docker, desplegado en Render u
# otro host). Si está vacío, se usa el LibreOffice instalado en la
# máquina local. GOTENBERG_USER/PASSWORD son opcionales (solo si se
# activó autenticación básica en el servicio).
# GOTENBERG_URL=https://tu-servicio.onrender.com
# GOTENBERG_USER=
# GOTENBERG_PASSWORD=

# Notificación por correo al firmante cuando le toca su turno en una
# solicitud de permiso. Si no se configura nada, los correos no se
# envían de verdad: quedan impresos en la consola del servidor (útil
# en local).
#
# Opción A — cuentas @muniolivar.cl (Microsoft 365): el tenant tiene
# "Security Defaults" activado, que bloquea SMTP con usuario+contraseña
# sin importar la config del buzón — hay que usar Microsoft Graph API
# con una app registrada en Azure AD (Entra ID > App registrations),
# con el permiso de aplicación "Mail.Send" (con consentimiento de
# administrador) sobre Microsoft Graph.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=p.reyes@muniolivar.cl

# Opción B — Gmail u otro SMTP normal (se usa solo si no hay
# MS_GRAPH_CLIENT_ID configurado). Con Gmail: usa una "contraseña de
# aplicación" (no tu contraseña normal) — se genera en
# https://myaccount.google.com/apppasswords, requiere verificación en
# 2 pasos activada en la cuenta de Gmail.
# EMAIL_HOST_USER=tucuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña de aplicación de 16 letras

