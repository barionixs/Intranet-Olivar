DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dominio real del sitio en producción — usado para armar el link del QR
# de verificación en los PDF institucionales.
DJANGO_SITE_URL=http://localhost:8000

DB_NAME=intranet_olivar
DB_USER=intranet_olivar
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Solo para Vercel: si existe DATABASE_URL (la crea automáticamente la
# integración de Postgres/Neon en el dashboard de Vercel), se usa esa
# conexión en vez de los DB_* de arriba. Dejar vacío en desarrollo local.
# DATABASE_URL=

# Opcional: fuerza la contraseña del super admin al correr
# "aprovisionar_usuarios" en vez de generar una aleatoria.
# SUPERADMIN_PASSWORD=

# Solo para desplegar en Vercel: token del Blob store (Storage > Create
# Database > Blob en el dashboard de Vercel). Si está definido, los
# archivos subidos (comprobantes de firma, PDF de permisos, licencias
# médicas, liquidaciones) se guardan ahí en vez de en disco local, porque
# en Vercel el filesystem es de solo lectura y no persiste. Dejar vacío
# en desarrollo local.
# BLOB_READ_WRITE_TOKEN=

